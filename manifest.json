{
  "manifest_version": 3,
  "name": "Asset Grabber",
  "version": "1.2.0",
  "description": "Capture les assets d'une page à partir de ses appels réseau (y compris vidéos HLS), avec aperçu, puis télécharge ceux que tu choisis.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "webRequest",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Asset Grabber"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
